---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { TYPE_LABELS } from '../../site-config';
import { canonicalPath } from '../../lib/canonical';

const entries = await getCollection('books', ({ data }: any) => data.status === 'published');
entries.sort((a, b) => +b.data.date - +a.data.date);

function thumbFor(entry: any): string {
  return entry.data.hero_image ?? `/images/${entry.slug}-thumb.jpg`;
}
---

<BaseLayout
  title="Books"
  description="Books from the corpus—long-form work bound between covers."
>
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="font-serif text-4xl text-ink mb-2">Books</h1>
    <p class="text-muted mb-10">Long-form work, newest first.</p>

    {entries.length === 0 ? (
      <p class="text-muted">No published books yet.</p>
    ) : (
      <ul class="space-y-6">
        {entries.map((e) => (
          <li class="flex items-start gap-4">
            <a
              href={e.data.external_url ?? canonicalPath(e)}
              class="shrink-0 block no-underline"
              aria-hidden="true"
              tabindex="-1"
            >
              <img
                src={thumbFor(e)}
                alt=""
                width="80"
                height="80"
                class="w-[60px] h-[60px] sm:w-20 sm:h-20 object-cover rounded-[4px]"
                loading="lazy"
              />
            </a>
            <div class="flex-1 min-w-0">
              <div class="flex items-baseline gap-3 mb-1">
                <time
                  datetime={e.data.date.toISOString()}
                  class="text-xs text-muted tabular-nums shrink-0"
                >
                  {new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(e.data.date)}
                </time>
                <span class="text-xs uppercase tracking-widest text-muted">
                  {TYPE_LABELS[e.data.type] ?? e.data.type}
                </span>
              </div>
              <a
                href={e.data.external_url ?? canonicalPath(e)}
                class="font-serif text-xl text-ink hover:text-accent no-underline"
              >
                {e.data.title}
              </a>
              <p class="text-sm text-muted mt-1">{e.data.abstract}</p>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
