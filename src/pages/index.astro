---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE, COLLECTIONS } from '../site-config';
import { canonicalPath } from '../lib/canonical';

type Entry = { data: any; body: string };

const all: Entry[] = [];
for (const c of COLLECTIONS) {
  const entries = await getCollection(c, ({ data }: any) => data.status === 'published');
  for (const e of entries) all.push(e);
}

const sorted = all.sort((a, b) => +b.data.date - +a.data.date);
const foundational = sorted.filter((e) => e.data.tags?.includes('foundational'));
const recent = sorted.slice(0, 6);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  url: SITE.url,
  description: SITE.description,
  sameAs: [SITE.github].filter(Boolean),
};
---

<BaseLayout title={undefined} description={SITE.description} jsonLd={personSchema}>
  {/* Masthead + brief lead. The full intro continues further down,
      after Foundational treatises and Recent — corpus weight first. */}
  <section class="mx-auto max-w-3xl px-4 pt-16 pb-8">
    <h1 class="font-serif text-5xl leading-tight text-ink mb-4">{SITE.title}</h1>
    {/* "Bits Protect Its." is the corpus thesis — sized as a
        secondary heading rather than a tagline. Slightly tighter
        tracking, italic, in the warm umber accent. */}
    <p class="font-serif italic tracking-tight text-accent text-3xl sm:text-4xl leading-tight mb-10">{SITE.subtitle}</p>
    <p class="max-w-2xl text-lg leading-relaxed text-ink">
      Founder and CEO of EnviroAI. Environmental attorney for twenty-seven
      years. Building real-time, physics-grounded information infrastructure
      for the biosphere—and writing here about why information has 10²⁰
      times the leverage over matter that we currently treat it as having.
    </p>
  </section>

  {/* Thesis block. Sits between the intro and the corpus presentation;
      no section header — the block itself is the thesis. Subtle umber
      hairlines top and bottom set it apart without making it a card. */}
  <section class="border-y border-accent/40">
    <div class="mx-auto max-w-3xl px-4 py-20 text-center">
      <p class="font-serif italic text-2xl sm:text-3xl leading-snug text-ink mb-12">
        Information accumulates causal sovereignty over matter and energy.
      </p>
      <div class="font-serif text-2xl sm:text-3xl text-ink mb-12 flex items-center justify-center gap-3">
        <span class="italic">Λ</span>
        <span aria-hidden="true">=</span>
        <span class="inline-flex flex-col items-center text-xl sm:text-2xl">
          <span class="italic px-3 pb-1">Mc²</span>
          <span class="border-t border-ink/40 px-3 pt-1">
            <span class="italic">I</span>
            <span aria-hidden="true"> · </span>
            <span class="italic">k</span><sub class="not-italic text-sm">B</sub><span class="italic">T</span>
            <span aria-hidden="true"> </span>ln 2
          </span>
        </span>
      </div>
      <p class="text-base sm:text-lg leading-relaxed text-muted max-w-2xl mx-auto mb-8">
        The energy cost of knowing where atoms are is roughly 10²⁰ times less
        than the energy cost of moving them once they have scattered.
      </p>
      <p class="text-sm text-muted">
        <a href="/essays/intelligence-leverage-equation" class="hover:text-accent">
          Read the derivation →
        </a>
      </p>
    </div>
  </section>

  {foundational.length > 0 && (
    <section class="mx-auto max-w-5xl px-4 py-20">
      <h2 class="font-serif text-2xl text-accent mb-2">Foundational treatises</h2>
      <hr class="border-accent/40 mb-10" />
      {/* Cover thumbnails are intentionally scoped to the foundational
          grid only. Recent, Archive, tag pages, and the collection
          indexes stay text-only by design — corpus-scale, not
          gallery-style. */}
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-12">
        {foundational.map((e) => (
          <li>
            <a
              href={canonicalPath(e)}
              class="group no-underline flex gap-5 items-start"
            >
              {e.data.hero_image && (
                <img
                  src={e.data.hero_image}
                  alt={e.data.hero_image_alt ?? e.data.title}
                  class="w-[140px] shrink-0 rounded-[2px] object-cover"
                  loading="lazy"
                />
              )}
              <div class="flex-1 min-w-0">
                <p class="font-serif text-lg leading-snug text-ink group-hover:text-accent">
                  {e.data.title}
                </p>
                {e.data.subtitle && (
                  <p class="font-serif italic text-sm leading-snug text-muted mt-1">
                    {e.data.subtitle}
                  </p>
                )}
                <p class="text-sm text-muted mt-2 leading-snug line-clamp-4">
                  {e.data.abstract}
                </p>
                <p class="mt-3 text-xs text-muted">
                  <time datetime={e.data.date.toISOString()}>
                    {new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }).format(e.data.date)}
                  </time>
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {recent.length > 0 && (
    <section class="mx-auto max-w-3xl px-4 py-20 border-t border-rule">
      <h2 class="font-serif text-2xl text-accent mb-2">Recent</h2>
      <hr class="border-accent/40 mb-10" />
      <ul class="space-y-3">
        {recent.map((e) => (
          <li class="flex items-baseline gap-3">
            <time
              datetime={e.data.date.toISOString()}
              class="text-xs text-muted tabular-nums w-28 shrink-0"
            >
              {new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }).format(e.data.date)}
            </time>
            <a href={canonicalPath(e)} class="text-ink hover:text-accent">
              {e.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="mx-auto max-w-3xl px-4 py-16 border-t border-rule">
    <h2 class="font-serif text-2xl text-accent mb-2">Browse</h2>
    <hr class="border-accent/40 mb-6" />
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-ink">
      <li><a href="/essays" class="underline hover:text-accent">Essays</a></li>
      <li><a href="/posts" class="underline hover:text-accent">Posts</a></li>
      <li><a href="/books" class="underline hover:text-accent">Books</a></li>
    </ul>
  </section>
</BaseLayout>
