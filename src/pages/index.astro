---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE, COLLECTIONS } from '../site-config';
import { canonicalPath } from '../lib/canonical';
import { effectiveDate } from '../lib/dates';

type Entry = { data: any; body: string };

const all: Entry[] = [];
for (const c of COLLECTIONS) {
  const entries = await getCollection(c, ({ data }: any) => data.status === 'published');
  for (const e of entries) all.push(e);
}

// Sort by effectiveDate so historical posts (with original_date set) don't
// pollute Recent with their 2026 ingestion date. Same convention used in
// /posts, /archive, llms.txt, and feed.xml.
const sorted = all.sort((a, b) => +effectiveDate(b) - +effectiveDate(a));
// "Start here" is driven exclusively by the `cornerstone` tag. Order is
// editorial — set per-essay via the `start_here_order` integer in
// frontmatter (1 = lead). Cornerstones without the field fall to the
// bottom in date-desc order (the default `sorted` order).
const cornerstone = sorted
  .filter((e) => e.data.tags?.includes('cornerstone'))
  .sort((a, b) => {
    const ao = a.data.start_here_order ?? Number.POSITIVE_INFINITY;
    const bo = b.data.start_here_order ?? Number.POSITIVE_INFINITY;
    if (ao !== bo) return ao - bo;
    // Tie-break: keep date-desc for any unordered cornerstones.
    return +effectiveDate(b) - +effectiveDate(a);
  });
const foundational = sorted.filter(
  (e) => e.data.tags?.includes('foundational') && !e.data.tags?.includes('cornerstone'),
);
const recent = sorted.slice(0, 6);
// "About this work" surfaces the personal/narrative on-ramp essay
// (The Arc) above Start here. Distinct from Start here, which holds
// the conceptual cornerstones. Resolved by slug so the section auto-
// hides if the essay is unpublished.
const aboutThisWork = sorted.find(
  (e: any) => e.collection === 'essays' && e.slug === 'the-arc',
);
// The Concepts block surfaces the three-term definitional ladder
// (EI → EAI → ESI) one hop from the root, so readers and crawlers reach
// the canonical definitions directly from the homepage. Resolved by
// slug in ladder order; an entry auto-hides if unpublished. The
// one-line glosses are editorial — compressed from each page's
// defined_term_description.
const CONCEPT_LADDER: { slug: string; gloss: string }[] = [
  {
    slug: 'environmental-intelligence',
    gloss:
      'The base term: the state of the physical environment, converted into understanding precise enough—and timely enough—to act on.',
  },
  {
    slug: 'environmental-artificial-intelligence',
    gloss:
      'The implementation layer: AI built specifically for environmental work, answerable to physical ground truth.',
  },
  {
    slug: 'environmental-superintelligence',
    gloss:
      'The mature form: continuous, physics-grounded information infrastructure protecting the biosphere—bits protect its.',
  },
];
const concepts = CONCEPT_LADDER.map((c) => ({
  ...c,
  entry: sorted.find((e: any) => e.collection === 'essays' && e.slug === c.slug),
})).filter((c) => c.entry);
// Site-wide Person/Organization/WebSite JSON-LD is emitted by
// BaseLayout via lib/site-entities; no page-scoped schema needed here.
---

<BaseLayout title={undefined} description={SITE.description}>
  {/* Masthead. Tightened vertical rhythm so the first row of
      Foundational treatises sits above the fold on a standard
      1080px desktop viewport. */}
  <section class="mx-auto max-w-3xl px-4 pt-8 pb-4">
    <h1 class="font-serif text-5xl leading-tight text-ink mb-4">{SITE.title}</h1>
    {/* "Bits Protect Its." — the corpus thesis. Calibrated size /
        color / tracking; do not change without rechecking the
        masthead rhythm. */}
    <p class="font-serif italic tracking-tight text-accent text-3xl sm:text-4xl leading-tight mb-6">{SITE.subtitle}</p>
    <p class="max-w-2xl text-lg leading-relaxed text-ink">
      Writer and builder. Creator and CEO of EnviroAI. Twenty-seven years
      as an environmental attorney. Adjunct professor of law. Working at
      the intersection of physics, information theory, and the protection
      of nature.
    </p>
  </section>

  {aboutThisWork && (
    <section class="mx-auto max-w-5xl px-4 pt-10 pb-16">
      <h2 class="font-serif text-2xl text-accent mb-2">About this work</h2>
      <hr class="border-accent/40 mb-10" />
      {/* Same card pattern as Start here entries, intentionally without
          a cover image. The missing image signals the different
          function — personal/narrative on-ramp, distinct from the
          conceptual on-ramps in Start here. */}
      <ul class="space-y-14">
        <li>
          <a
            href={canonicalPath(aboutThisWork)}
            class="group no-underline flex gap-6 items-start"
          >
            <div class="flex-1 min-w-0">
              <p class="font-serif text-2xl leading-snug text-ink group-hover:text-accent">
                {aboutThisWork.data.title}
              </p>
              {aboutThisWork.data.subtitle && (
                <p class="font-serif italic text-base leading-snug text-muted mt-2">
                  {aboutThisWork.data.subtitle}
                </p>
              )}
              <p class="text-base text-muted mt-3 leading-relaxed">
                {aboutThisWork.data.abstract}
              </p>
              <p class="mt-4 text-sm text-muted">
                <time datetime={effectiveDate(aboutThisWork).toISOString()}>
                  {new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }).format(effectiveDate(aboutThisWork))}
                </time>
              </p>
            </div>
          </a>
        </li>
      </ul>
    </section>
  )}

  {cornerstone.length > 0 && (
    <section class="mx-auto max-w-5xl px-4 pt-10 pb-16">
      <h2 class="font-serif text-2xl text-accent mb-2">Start here</h2>
      <hr class="border-accent/40 mb-10" />
      <ul class="space-y-14">
        {cornerstone.map((e) => (
          <li>
            <a
              href={canonicalPath(e)}
              class="group no-underline flex gap-6 items-start"
            >
              {e.data.hero_image && (
                /* Decorative on the homepage: the card link's accessible name
                   already contains the title, subtitle, abstract, and date.
                   The cover is reinforcement, not information — empty alt
                   keeps it out of the anchor's accessible name. The
                   descriptive alt is preserved on the standalone essay page. */
                <img
                  src={e.data.hero_image}
                  alt=""
                  class="w-[200px] shrink-0 rounded-[2px] object-cover"
                  loading="eager"
                />
              )}
              <div class="flex-1 min-w-0">
                <p class="font-serif text-2xl leading-snug text-ink group-hover:text-accent">
                  {e.data.title}
                </p>
                {e.data.subtitle && (
                  <p class="font-serif italic text-base leading-snug text-muted mt-2">
                    {e.data.subtitle}
                  </p>
                )}
                <p class="text-base text-muted mt-3 leading-relaxed">
                  {e.data.abstract}
                </p>
                <p class="mt-4 text-sm text-muted">
                  <time datetime={effectiveDate(e).toISOString()}>
                    {new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }).format(effectiveDate(e))}
                  </time>
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {foundational.length > 0 && (
    <section class="mx-auto max-w-5xl px-4 pt-4 pb-20">
      <h2 class="font-serif text-2xl text-accent mb-2">Foundational treatises</h2>
      <hr class="border-accent/40 mb-10" />
      {/* Cover thumbnails are intentionally scoped to the foundational
          grid only. Recent, Archive, tag pages, and the collection
          indexes stay text-only by design — corpus-scale, not
          gallery-style. */}
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-12">
        {foundational.map((e) => (
          <li>
            <a
              href={canonicalPath(e)}
              class="group no-underline flex gap-5 items-start"
            >
              {e.data.hero_image && (
                /* Decorative — see Start-here card. */
                <img
                  src={e.data.hero_image}
                  alt=""
                  class="w-[140px] shrink-0 rounded-[2px] object-cover"
                  loading="lazy"
                />
              )}
              <div class="flex-1 min-w-0">
                <p class="font-serif text-lg leading-snug text-ink group-hover:text-accent">
                  {e.data.title}
                </p>
                {e.data.subtitle && (
                  <p class="font-serif italic text-sm leading-snug text-muted mt-1">
                    {e.data.subtitle}
                  </p>
                )}
                <p class="text-sm text-muted mt-2 leading-snug line-clamp-4">
                  {e.data.abstract}
                </p>
                <p class="mt-3 text-xs text-muted">
                  <time datetime={effectiveDate(e).toISOString()}>
                    {new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }).format(effectiveDate(e))}
                  </time>
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {concepts.length > 0 && (
    <section class="mx-auto max-w-3xl px-4 py-16 border-t border-rule">
      <h2 class="font-serif text-2xl text-accent mb-2">Concepts</h2>
      <hr class="border-accent/40 mb-6" />
      <p class="text-sm text-muted mb-8">
        The corpus's defining ladder, base to summit. Each term has a
        canonical definition page; each rung contains the ones below it.
      </p>
      <ol class="space-y-6">
        {concepts.map((c) => (
          <li>
            <a href={canonicalPath(c.entry)} class="group no-underline block">
              <p class="font-serif text-lg leading-snug text-ink group-hover:text-accent">
                {c.entry.data.title}
              </p>
              <p class="text-sm text-muted mt-1 leading-relaxed">{c.gloss}</p>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}

  {recent.length > 0 && (
    <section class="mx-auto max-w-3xl px-4 py-20 border-t border-rule">
      <h2 class="font-serif text-2xl text-accent mb-2">Recent</h2>
      <hr class="border-accent/40 mb-10" />
      <ul class="space-y-3">
        {recent.map((e) => (
          <li class="flex items-baseline gap-3">
            <time
              datetime={effectiveDate(e).toISOString()}
              class="text-xs text-muted tabular-nums w-28 shrink-0"
            >
              {new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }).format(effectiveDate(e))}
            </time>
            <a href={canonicalPath(e)} class="text-ink hover:text-accent">
              {e.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="mx-auto max-w-3xl px-4 py-16 border-t border-rule">
    <h2 class="font-serif text-2xl text-accent mb-2">Browse</h2>
    <hr class="border-accent/40 mb-6" />
    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-ink">
      <li><a href="/essays" class="underline hover:text-accent">Essays</a></li>
      <li><a href="/posts" class="underline hover:text-accent">Posts</a></li>
      <li><a href="/books" class="underline hover:text-accent">Books</a></li>
    </ul>
  </section>
</BaseLayout>
