---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { canonicalPath } from '../../lib/canonical';
import { effectiveDate } from '../../lib/dates';

const entries = await getCollection('speeches', ({ data }: any) => data.status === 'published');
entries.sort((a: any, b: any) => +effectiveDate(b) - +effectiveDate(a));

const longFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  timeZone: 'UTC',
});
---

<BaseLayout
  title="Talks"
  description="Podcasts, lectures, and presentations on environmental superintelligence, AI, and the Clean Air Act."
>
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="font-serif text-4xl text-ink mb-2">Talks</h1>
    <p class="text-muted mb-10">Podcasts, lectures, and presentations. Newest first.</p>

    {entries.length === 0 ? (
      <p class="text-muted">No talks yet.</p>
    ) : (
      <ul class="space-y-8">
        {entries.map((e: any) => (
          <li>
            <div class="flex items-baseline gap-3 mb-1">
              <time
                datetime={effectiveDate(e).toISOString()}
                class="text-xs text-muted tabular-nums shrink-0"
              >
                {longFmt.format(effectiveDate(e))}
              </time>
              {e.data.host_org && (
                <span class="text-xs uppercase tracking-widest text-muted">
                  {e.data.host_org}
                </span>
              )}
            </div>
            <a
              href={canonicalPath(e)}
              class="font-serif text-xl text-ink hover:text-accent no-underline"
            >
              {e.data.title}
            </a>
            {e.data.subtitle && (
              <p class="text-sm text-muted italic mt-1">{e.data.subtitle}</p>
            )}
            <p class="text-sm text-muted mt-2">{e.data.abstract}</p>
            {e.data.external_url && (
              <p class="text-sm mt-2">
                <a href={e.data.external_url} class="underline hover:text-accent">
                  Listen / watch →
                </a>
              </p>
            )}
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
