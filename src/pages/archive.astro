---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { COLLECTIONS, SITE, TYPE_LABELS } from '../site-config';
import { canonicalPath } from '../lib/canonical';
import { effectiveDate } from '../lib/dates';
import { JED_ID, WEBSITE_ID } from '../lib/site-entities';

const all: any[] = [];
for (const c of COLLECTIONS) {
  const entries = await getCollection(c, ({ data }: any) => data.status === 'published');
  for (const e of entries) all.push(e);
}

all.sort((a, b) => +effectiveDate(b) - +effectiveDate(a));

const grouped = new Map<number, any[]>();
for (const e of all) {
  const y = effectiveDate(e).getUTCFullYear();
  if (!grouped.has(y)) grouped.set(y, []);
  grouped.get(y)!.push(e);
}
const years = [...grouped.keys()].sort((a, b) => b - a);

const archiveDescription = 'Full chronological index of every published piece.';
const archiveUrl = `${SITE.url}/archive`;
const archiveSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${archiveUrl}#page`,
  url: archiveUrl,
  name: 'Archive',
  description: archiveDescription,
  isPartOf: { '@id': WEBSITE_ID },
  author: { '@id': JED_ID },
  inLanguage: 'en',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: all.length,
    itemListElement: all.map((e: any, idx: number) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: e.data.title,
      url: `${SITE.url}${canonicalPath(e)}`,
    })),
  },
};
---

<BaseLayout title="Archive" description={archiveDescription} jsonLd={archiveSchema}>
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="font-serif text-4xl text-ink mb-2">Archive</h1>
    <p class="text-muted mb-10">Every published piece, newest first.</p>

    {all.length === 0 && <p class="text-muted">No published pieces yet.</p>}

    {years.map((year) => (
      <section class="mb-12">
        <h2 class="font-serif text-2xl text-muted border-b border-rule pb-1 mb-4">{year}</h2>
        <ul class="space-y-6">
          {grouped.get(year)!.map((e) => (
            <li>
              <div class="flex items-baseline gap-3 mb-1">
                <time
                  datetime={effectiveDate(e).toISOString()}
                  class="text-xs text-muted tabular-nums w-24 shrink-0"
                >
                  {new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' }).format(effectiveDate(e))}
                </time>
                <span class="text-xs uppercase tracking-widest text-muted">
                  {TYPE_LABELS[e.data.type] ?? e.data.type}
                </span>
              </div>
              <a href={canonicalPath(e)} class="font-serif text-xl text-ink hover:text-accent no-underline">
                {e.data.title}
              </a>
              <p class="text-sm text-muted mt-1">{e.data.abstract}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
</BaseLayout>
