---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { TYPE_LABELS } from '../../site-config';
import { canonicalPath } from '../../lib/canonical';

const entries = await getCollection('posts', ({ data }: any) => data.status === 'published');
entries.sort((a, b) => +b.data.date - +a.data.date);
---

<BaseLayout
  title="Posts"
  description="Shorter writing and updates — posts from the corpus."
>
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="font-serif text-4xl text-ink mb-2">Posts</h1>
    <p class="text-muted mb-10">Shorter writing and updates, newest first.</p>

    {entries.length === 0 ? (
      <p class="text-muted">No published posts yet.</p>
    ) : (
      <ul class="space-y-6">
        {entries.map((e) => (
          <li>
            <div class="flex items-baseline gap-3 mb-1">
              <time
                datetime={e.data.date.toISOString()}
                class="text-xs text-muted tabular-nums w-24 shrink-0"
              >
                {new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(e.data.date)}
              </time>
              <span class="text-xs uppercase tracking-widest text-muted">
                {TYPE_LABELS[e.data.type] ?? e.data.type}
              </span>
            </div>
            <a href={canonicalPath(e)} class="font-serif text-xl text-ink hover:text-accent no-underline">
              {e.data.title}
            </a>
            <p class="text-sm text-muted mt-1">{e.data.abstract}</p>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
