---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { TYPE_LABELS } from '../../site-config';
import { canonicalPath } from '../../lib/canonical';
import { effectiveDate } from '../../lib/dates';

const entries = await getCollection('essays', ({ data }: any) => data.status === 'published');
entries.sort((a, b) => +effectiveDate(b) - +effectiveDate(a));

// Thumbnail strategy for the essays index:
// - hero_image when set on the frontmatter (visual essays + prose essays
//   with cover art);
// - otherwise the typographic fallback at /images/{slug}-thumb.jpg
//   produced by scripts/generate-thumbnails.py at build time.
function thumbFor(entry: any): string {
  return entry.data.hero_image ?? `/images/${entry.slug}-thumb.jpg`;
}

function isInteractive(entry: any): boolean {
  return Array.isArray(entry.data.tags) && entry.data.tags.includes('visual-essay');
}
---

<BaseLayout
  title="Essays"
  description="Long-form writing on environmental superintelligence, information physics, and the causal sovereignty of knowledge over matter and energy."
>
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="font-serif text-4xl text-ink mb-2">Essays</h1>
    <p class="text-muted mb-10">Long-form writing, newest first.</p>

    {entries.length === 0 ? (
      <p class="text-muted">No published essays yet.</p>
    ) : (
      <ul class="space-y-6">
        {entries.map((e) => (
          <li class="flex items-start gap-4">
            <a href={canonicalPath(e)} class="shrink-0 block no-underline" aria-hidden="true" tabindex="-1">
              <img
                src={thumbFor(e)}
                alt=""
                width="80"
                height="80"
                class="w-[60px] h-[60px] sm:w-20 sm:h-20 object-cover rounded-[4px]"
                loading="lazy"
              />
            </a>
            <div class="flex-1 min-w-0">
              <div class="flex items-baseline gap-3 mb-1">
                <time
                  datetime={effectiveDate(e).toISOString()}
                  class="text-xs text-muted tabular-nums shrink-0"
                >
                  {new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(effectiveDate(e))}
                </time>
                <span class="text-xs uppercase tracking-widest text-muted">
                  {TYPE_LABELS[e.data.type] ?? e.data.type}{isInteractive(e) && ' · Interactive'}
                </span>
              </div>
              <a href={canonicalPath(e)} class="font-serif text-xl text-ink hover:text-accent no-underline">
                {e.data.title}
              </a>
              <p class="text-sm text-muted mt-1">{e.data.abstract}</p>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
