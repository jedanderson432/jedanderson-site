---
// Attribution box. States authorship of the archive and points to
// /about for the author's full profile. Rendered at the top of /about
// and as a footer block on every essay.
//
// Deliberately dark against the paper-white site so it reads as a
// distinct institutional panel rather than body copy. Kept out of the
// Pagefind index so the same boilerplate doesn't match every essay.

interface Props {
  placement?: 'about' | 'footer';
}

const { placement = 'footer' } = Astro.props;
const headingId = `sovereign-bridge-${placement}`;
---

<aside
  class:list={['sovereign-bridge', 'not-prose', `sovereign-bridge--${placement}`]}
  aria-labelledby={headingId}
  data-pagefind-ignore
>
  <p class="sb-eyebrow">Attribution</p>
  <h2 id={headingId} class="sb-title">About this archive</h2>
  <div class="sb-body">
    <p>
      This archive is sole-authored by Jed Anderson, environmental attorney
      and independent researcher. He is the Creator and CEO of EnviroAI, the
      commercial application of this work. <a href="/about">About the author</a>.
    </p>
  </div>
</aside>

<style>
  .sovereign-bridge {
    --sb-bg: #0a1628;
    --sb-bg-deep: #000000;
    --sb-cyan: #00ced1;
    --sb-teal: #40c4b0;
    --sb-text: #f2efe8;
    --sb-text-soft: #c9c6bd;

    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, var(--sb-bg) 0%, var(--sb-bg-deep) 100%);
    color: var(--sb-text);
    border: 1px solid rgba(64, 196, 176, 0.22);
    border-radius: 4px;
    padding: 1.75rem 1.5rem 1.6rem;
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  /* Top accent line: teal-to-cyan, the one element meant to catch the eye. */
  .sovereign-bridge::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--sb-teal), var(--sb-cyan) 60%, rgba(0, 206, 209, 0));
  }

  .sovereign-bridge--about {
    margin: 0 0 2.5rem;
  }
  .sovereign-bridge--footer {
    margin: 3.5rem 0 0;
  }

  .sb-eyebrow {
    margin: 0 0 0.6rem;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sb-teal);
  }

  .sb-title {
    margin: 0 0 1rem;
    font-family: 'Iowan Old Style', Palatino, Georgia, serif;
    font-size: clamp(1.3rem, 3.6vw, 1.6rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--sb-text);
  }

  .sb-body p {
    margin: 0;
    font-size: 0.975rem;
    line-height: 1.65;
    color: var(--sb-text-soft);
  }

  .sb-body a {
    color: var(--sb-cyan);
    text-decoration: underline;
    text-decoration-color: rgba(0, 206, 209, 0.45);
    text-underline-offset: 0.2em;
    transition: color 150ms ease, text-decoration-color 150ms ease;
  }
  .sb-body a:hover,
  .sb-body a:focus-visible {
    color: var(--sb-text);
    text-decoration-color: var(--sb-text);
  }
  .sb-body a:focus-visible {
    outline: 2px solid var(--sb-cyan);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (min-width: 640px) {
    .sovereign-bridge {
      padding: 2.1rem 2.25rem 2rem;
    }
  }

  /* Essay PDFs are prints of the rendered page (scripts/generate-pdfs.mjs,
     scripts/render-page-pdf.mjs); keep the footer box out of them. */
  @media print {
    .sovereign-bridge--footer {
      display: none;
    }
  }
</style>
