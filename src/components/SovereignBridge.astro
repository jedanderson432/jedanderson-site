---
// "Sovereign Bridge" attribution box. Connects the theoretical archive
// on this site to its operational foundation at EnviroAI. Rendered at
// the top of /about and as a footer block on every essay.
//
// Deliberately dark against the paper-white site so it reads as a
// distinct institutional panel rather than body copy. Kept out of the
// Pagefind index so the same boilerplate doesn't match every essay.

interface Props {
  placement?: 'about' | 'footer';
}

const { placement = 'footer' } = Astro.props;
const headingId = `sovereign-bridge-${placement}`;
---

<aside
  class:list={['sovereign-bridge', 'not-prose', `sovereign-bridge--${placement}`]}
  aria-labelledby={headingId}
  data-pagefind-ignore
>
  <p class="sb-eyebrow">Attribution</p>
  <h2 id={headingId} class="sb-title">
    About This Archive &amp; The Empirical Engine Behind It
  </h2>
  <div class="sb-body">
    <p>
      <span class="sb-domain">jedanderson.org</span> is the sole-authored
      theoretical research archive of environmental attorney and
      physicist-theorist Jed Anderson. It lays out the mathematical and
      thermodynamic foundations for Environmental Superintelligence and the
      Large Nature Model (LNM).
    </p>
    <p>
      These frameworks are not purely theoretical. Their commercial
      foundation is already operational at EnviroAI (<a
        href="https://www.enviro.ai"
        target="_blank"
        rel="noopener">www.enviro.ai</a
      >)—co-founded and led by Jed as CEO—where an AI architecture connecting
      20 million+ environmental compliance documents and live geospatial
      environmental data is deployed today by global industrial leaders
      including ExxonMobil, LyondellBasell, and Formosa. The LNM is the next
      frontier actively being built on top of this foundation.
    </p>
  </div>
</aside>

<style>
  .sovereign-bridge {
    --sb-bg: #0a1628;
    --sb-bg-deep: #000000;
    --sb-cyan: #00ced1;
    --sb-teal: #40c4b0;
    --sb-text: #f2efe8;
    --sb-text-soft: #c9c6bd;

    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, var(--sb-bg) 0%, var(--sb-bg-deep) 100%);
    color: var(--sb-text);
    border: 1px solid rgba(64, 196, 176, 0.22);
    border-radius: 4px;
    padding: 1.75rem 1.5rem 1.6rem;
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  /* Top accent line: teal-to-cyan, the one element meant to catch the eye. */
  .sovereign-bridge::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--sb-teal), var(--sb-cyan) 60%, rgba(0, 206, 209, 0));
  }

  .sovereign-bridge--about {
    margin: 0 0 2.5rem;
  }
  .sovereign-bridge--footer {
    margin: 3.5rem 0 0;
  }

  .sb-eyebrow {
    margin: 0 0 0.6rem;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sb-teal);
  }

  .sb-title {
    margin: 0 0 1rem;
    font-family: 'Iowan Old Style', Palatino, Georgia, serif;
    font-size: clamp(1.3rem, 3.6vw, 1.6rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--sb-text);
  }

  .sb-body p {
    margin: 0;
    font-size: 0.975rem;
    line-height: 1.65;
    color: var(--sb-text-soft);
  }
  .sb-body p + p {
    margin-top: 0.9rem;
  }

  .sb-domain {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.92em;
    color: var(--sb-cyan);
  }

  .sb-body a {
    color: var(--sb-cyan);
    text-decoration: underline;
    text-decoration-color: rgba(0, 206, 209, 0.45);
    text-underline-offset: 0.2em;
    transition: color 150ms ease, text-decoration-color 150ms ease;
  }
  .sb-body a:hover,
  .sb-body a:focus-visible {
    color: var(--sb-text);
    text-decoration-color: var(--sb-text);
  }
  .sb-body a:focus-visible {
    outline: 2px solid var(--sb-cyan);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (min-width: 640px) {
    .sovereign-bridge {
      padding: 2.1rem 2.25rem 2rem;
    }
  }
</style>
