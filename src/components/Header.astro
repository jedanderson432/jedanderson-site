---
// Canonical site header. Single source of truth for the primary nav.
// Imported by BaseLayout.astro, which is wrapped (directly or via
// ContentLayout) by every route under src/pages. Do NOT duplicate
// this markup inline on any page — when the nav needs to change,
// it changes here once and propagates to every built page on rebuild.
// Item order is editorial: Essays · Posts · Books · Talks · Lines · About.
import { SITE } from '../site-config';
---

<header class="border-b border-rule">
  <div class="mx-auto max-w-3xl px-4 py-5 flex items-baseline justify-between gap-6">
    <a href="/" class="font-serif text-xl text-ink no-underline hover:text-accent">
      {SITE.title}
    </a>
    <nav aria-label="Primary" class="flex items-center gap-4 text-sm text-muted">
      <a href="/essays" class="hover:text-ink">Essays</a>
      <a href="/posts" class="hover:text-ink">Posts</a>
      <a href="/books" class="hover:text-ink">Books</a>
      <a href="/talks" class="hover:text-ink">Talks</a>
      <a href="/lines" class="hover:text-ink">Lines</a>
      <a href="/about" class="hover:text-ink">About</a>
      <button
        type="button"
        data-search-trigger
        aria-label="Open search (press / to focus)"
        class="rounded border border-rule px-2 py-0.5 text-muted hover:text-ink hover:border-ink"
      >
        Search <span class="ml-1 text-xs opacity-70">/</span>
      </button>
    </nav>
  </div>
</header>
