---
// Pagefind-backed search modal. Phase 6 wires the Pagefind UI bundle
// against the static index produced by `pagefind --site dist`. The
// /pagefind/* assets only exist after a production build, so this
// component degrades gracefully in `astro dev`.
---

<dialog
  id="search-modal"
  class="m-0 mt-12 max-w-2xl w-full rounded-lg border border-rule bg-paper p-0 shadow-xl backdrop:bg-ink/40"
  aria-label="Site search"
>
  <div class="p-4">
    <div id="pagefind-search"></div>
    <p class="mt-3 text-xs text-muted">
      Press <kbd class="rounded border border-rule px-1">Esc</kbd> to close.
    </p>
  </div>
</dialog>

<script>
  const modal = document.getElementById('search-modal') as HTMLDialogElement | null;
  const triggers = document.querySelectorAll<HTMLElement>('[data-search-trigger]');
  let initialized = false;
  let ui: any = null;

  async function ensureInitialized() {
    if (initialized || !modal) return;
    const mount = document.getElementById('pagefind-search');
    if (!mount) return;
    try {
      // Pagefind UI is a static asset under /pagefind/, present only
      // after `pagefind --site dist` runs in the build pipeline.
      // The Function() wrapper hides the import from Vite's static
      // analyzer so it doesn't try to bundle a path that doesn't
      // exist at build time.
      const dynImport = new Function('p', 'return import(p)');
      const mod = await dynImport('/pagefind/pagefind-ui.js');
      // pagefind-ui.js is an IIFE, not an ES module — it attaches the
      // constructor to window rather than exporting it. Importing it
      // executes the script; the constructor is read from the global.
      const PagefindUI = mod?.PagefindUI ?? (window as any).PagefindUI;
      if (!PagefindUI) throw new Error('PagefindUI global not found after import');
      ui = new PagefindUI({
        element: '#pagefind-search',
        bundlePath: '/pagefind/',
        showSubResults: true,
      });
      initialized = true;
    } catch (err) {
      console.error('[search] Pagefind UI failed to load:', err);
      mount.innerHTML =
        '<p class="text-muted text-sm">Search is unavailable on this build. (See console for details.)</p>';
    }
  }

  function open() {
    if (!modal) return;
    ensureInitialized();
    modal.showModal();
    setTimeout(() => {
      const input = modal.querySelector<HTMLInputElement>('input');
      input?.focus();
    }, 0);
  }

  triggers.forEach((t) => t.addEventListener('click', open));

  document.addEventListener('keydown', (e) => {
    if (
      e.key === '/' &&
      !(e.target instanceof HTMLInputElement) &&
      !(e.target instanceof HTMLTextAreaElement) &&
      !modal?.open
    ) {
      e.preventDefault();
      open();
    }
  });

  // Deep link: /?q=term opens the modal pre-searched. This is the
  // EntryPoint target of the WebSite SearchAction JSON-LD, so the URL
  // must actually perform a search when loaded.
  const initialQuery = new URLSearchParams(location.search).get('q');
  if (initialQuery && modal) {
    (async () => {
      await ensureInitialized();
      modal.showModal();
      ui?.triggerSearch(initialQuery);
    })();
  }
</script>
