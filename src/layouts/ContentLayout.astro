---
import BaseLayout from './BaseLayout.astro';
import CiteThis from '../components/CiteThis.astro';
import { getCollection } from 'astro:content';
import { SITE, TYPE_LABELS } from '../site-config';
import { canonicalFor, canonicalPath } from '../lib/canonical';
import { JED_ID, WEBSITE_ID } from '../lib/site-entities';

interface Props {
  entry: any;
  headings?: { depth: number; slug: string; text: string }[];
}

const { entry, headings = [] } = Astro.props;
const data = entry.data;
const body = entry.body ?? '';

const canonicalUrl = canonicalFor(entry);
const mdPath = `${canonicalPath(entry)}.md`;
const githubUrl = `${SITE.github}/blob/main/src/content/${entry.collection}/${entry.slug}.md`;
const h2s = headings.filter((h) => h.depth === 2);
const showAbstract = data.status !== 'published' || data.show_abstract_on_page;

// Resolve related_essay path → display title via collection lookup. The
// path is expected as /{collection}/{slug}; falls back to the raw path
// if the entry can't be found.
let relatedTitle: string | null = null;
if (data.related_essay) {
  const m = (data.related_essay as string).match(/^\/([^\/]+)\/([^\/]+)$/);
  if (m) {
    const [_, collection, slug] = m;
    try {
      const all = await getCollection(collection as any);
      const ref = all.find((e: any) => e.slug === slug);
      if (ref) relatedTitle = ref.data.title;
    } catch {
      // unknown collection — leave title null and render the URL
    }
  }
}
const longFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const dateLong = longFmt.format(data.date);
const originalDateLong = data.original_date ? longFmt.format(data.original_date) : null;

const isPaper = data.type === 'paper';
// Auto-promote foundational essays (type=essay AND tags includes
// "foundational") to ScholarlyArticle JSON-LD, in addition to any
// piece with explicit `schema_type: ScholarlyArticle` or type=paper.
const isFoundationalEssay =
  data.type === 'essay' && Array.isArray(data.tags) && data.tags.includes('foundational');
const useScholarlyArticle =
  data.schema_type === 'ScholarlyArticle' || isFoundationalEssay || isPaper;
const isPost = data.type === 'post';
const isBook = data.type === 'book';

const licenseUrl = data.license?.startsWith('CC0')
  ? 'https://creativecommons.org/publicdomain/zero/1.0/'
  : 'https://creativecommons.org/licenses/by/4.0/';

// Date semantics: `datePublished` must reflect the original publication
// date of the underlying work, not the date the piece appeared on
// jedanderson.org. The frontmatter `date` field is the most recent
// revision date here — used as `dateModified` unless an explicit
// `date_modified` override is set. `original_date`, when present, is
// the canonical first-publication date.
const datePublishedIso = (data.original_date ?? data.date).toISOString();
const dateModifiedIso = (data.date_modified ?? data.date).toISOString();

// Image and encoding are shared across all article variants (lifted
// out so ScholarlyArticle also gets them, not just the Article branch).
const imageUrl = data.hero_image
  ? new URL(data.hero_image, SITE.url).toString()
  : new URL('/og-default.png', SITE.url).toString();

const pdfAbsoluteUrl = data.pdf ? new URL(data.pdf, SITE.url).toString() : null;

// MediaObject array exposes the alternate retrieval surfaces for AI
// ingestion: the `.md` endpoint for raw markdown, and the PDF when one
// exists. Makes both schema-discoverable rather than only
// HTML-affordance-discoverable.
const encodingArr: Record<string, any>[] = [
  {
    '@type': 'MediaObject',
    encodingFormat: 'text/markdown',
    contentUrl: `${canonicalUrl}.md`,
  },
];
if (pdfAbsoluteUrl) {
  encodingArr.push({
    '@type': 'MediaObject',
    encodingFormat: 'application/pdf',
    contentUrl: pdfAbsoluteUrl,
  });
}

let articleSchema: Record<string, any>;

if (useScholarlyArticle) {
  // Canonical-citation-grade schema. Author and publisher are both
  // Person (Jed Anderson is the publisher of his own corpus). Keywords
  // come from frontmatter `keywords` when set, otherwise fall back to
  // tags. `about` becomes an array of Thing entities.
  const doiUrl = data.doi ? `https://doi.org/${data.doi}` : null;
  const keywordsValue =
    Array.isArray(data.keywords) && data.keywords.length > 0
      ? data.keywords.join(', ')
      : data.tags?.join(', ');
  articleSchema = {
    '@context': 'https://schema.org',
    '@type': 'ScholarlyArticle',
    '@id': `${canonicalUrl}#article`,
    headline: data.title,
    ...(data.subtitle ? { alternativeHeadline: data.subtitle } : {}),
    abstract: data.abstract,
    description: data.abstract,
    author: { '@id': JED_ID },
    datePublished: datePublishedIso,
    dateModified: dateModifiedIso,
    ...(data.original_date
      ? { dateCreated: data.original_date.toISOString() }
      : {}),
    url: canonicalUrl,
    mainEntityOfPage: canonicalUrl,
    citation: canonicalUrl,
    image: imageUrl,
    identifier: doiUrl ? [canonicalUrl, doiUrl] : canonicalUrl,
    ...(doiUrl ? { sameAs: [doiUrl] } : {}),
    license: licenseUrl,
    publisher: { '@id': JED_ID },
    isPartOf: { '@id': WEBSITE_ID },
    encoding: encodingArr,
    keywords: keywordsValue,
    ...(Array.isArray(data.about) && data.about.length > 0
      ? {
          about: data.about.map((name: string) => ({
            '@type': 'Thing',
            name,
          })),
        }
      : {}),
    inLanguage: 'en',
    isAccessibleForFree: true,
  };
} else if (isBook) {
  // Book schema for type=book. Uses schema.org Book vocabulary
  // (`name` instead of `headline`, optional isbn / bookFormat). Author
  // and publisher reference the site-wide Person entity by @id.
  articleSchema = {
    '@context': 'https://schema.org',
    '@type': 'Book',
    '@id': `${canonicalUrl}#book`,
    name: data.title,
    ...(data.subtitle ? { alternativeHeadline: data.subtitle } : {}),
    description: data.abstract,
    author: { '@id': JED_ID },
    publisher: { '@id': JED_ID },
    datePublished: datePublishedIso,
    dateModified: dateModifiedIso,
    url: canonicalUrl,
    mainEntityOfPage: canonicalUrl,
    citation: canonicalUrl,
    image: imageUrl,
    encoding: encodingArr,
    inLanguage: 'en',
    isPartOf: { '@id': WEBSITE_ID },
    license: licenseUrl,
    ...(data.isbn ? { isbn: data.isbn } : {}),
    ...(data.bookFormat
      ? { bookFormat: `https://schema.org/${data.bookFormat}` }
      : {}),
    ...(Array.isArray(data.tags) && data.tags.length > 0
      ? { keywords: data.tags.join(', ') }
      : {}),
  };
} else {
  // Posts get BlogPosting; letters, speeches, and non-foundational
  // essays get Article.
  const articleType = isPost ? 'BlogPosting' : 'Article';
  articleSchema = {
    '@context': 'https://schema.org',
    '@type': articleType,
    '@id': `${canonicalUrl}#article`,
    headline: data.title,
    description: data.abstract,
    author: { '@id': JED_ID },
    datePublished: datePublishedIso,
    dateModified: dateModifiedIso,
    url: canonicalUrl,
    mainEntityOfPage: canonicalUrl,
    citation: canonicalUrl,
    image: imageUrl,
    encoding: encodingArr,
    inLanguage: 'en',
    isPartOf: { '@id': WEBSITE_ID },
    license: licenseUrl,
    ...(Array.isArray(data.tags) && data.tags.length > 0
      ? { keywords: data.tags.join(', ') }
      : {}),
  };
}
---

<BaseLayout
  title={data.title}
  description={data.abstract}
  canonicalUrl={canonicalUrl}
  ogImage={data.hero_image}
  jsonLd={articleSchema}
>
  <article
    class:list={[
      'mx-auto max-w-3xl px-4 pb-12',
      data.hero_image && !data.pdf_canonical ? 'pt-8' : 'pt-12',
    ]}
    data-pagefind-body
    data-pagefind-meta={`title:${data.title}`}
    data-pagefind-filter={`type:${TYPE_LABELS[data.type] ?? data.type}`}
  >
    {data.hero_image && !data.pdf_canonical && (
      <img
        src={data.hero_image}
        alt={data.hero_image_alt ?? data.title}
        class="w-full h-auto rounded-[4px] mb-12"
        loading="eager"
      />
    )}

    <p class="text-xs uppercase tracking-widest text-muted mb-2">
      {TYPE_LABELS[data.type] ?? data.type}
    </p>
    <h1 class="font-serif text-4xl leading-tight text-ink mb-3">{data.title}</h1>
    {data.subtitle && (
      <p class="font-serif italic text-2xl text-muted leading-snug mb-5">
        {data.subtitle}
      </p>
    )}
    <p class="text-sm text-muted mb-8">
      {originalDateLong ? (
        <>
          <span>Originally written:{' '}
            <time datetime={data.original_date.toISOString()}>{originalDateLong}</time>
          </span>
          <span class="mx-2">·</span>
          <span>Published here:{' '}
            <time datetime={data.date.toISOString()}>{dateLong}</time>
          </span>
        </>
      ) : (
        <time datetime={data.date.toISOString()}>{dateLong}</time>
      )}
    </p>

    {data.interactive_url && (
      <a
        href={data.interactive_url}
        class="inline-flex items-center justify-center px-7 py-3 mb-10 bg-accent text-paper rounded-[3px] font-sans text-base no-underline tracking-wide hover:bg-ink transition-colors duration-200 shadow-sm hover:shadow-md"
      >
        {data.interactive_cta ?? 'Launch interactive experience →'}
      </a>
    )}

    {showAbstract && (
      <p class="italic text-muted border-l-2 border-rule pl-4 mb-10 text-lg leading-relaxed">
        {data.abstract}
      </p>
    )}

    {data.pdf && data.pdf_canonical && data.hero_image && (
      <>
        <div class="my-12">
          {/* Image is its own link to the PDF; subtle scale + shadow grow
              on hover signal clickability. */}
          <a
            href={data.pdf}
            target="_blank"
            rel="noopener"
            class="group block mx-auto max-w-[800px] no-underline"
            aria-label={`Open ${data.title} as PDF in a new tab`}
          >
            <img
              src={data.hero_image}
              alt={data.hero_image_alt ?? `Cover of ${data.title}`}
              class="w-full h-auto rounded-[4px] border border-rule shadow-md transition-all duration-200 group-hover:shadow-xl group-hover:scale-[1.01]"
              loading="eager"
            />
          </a>
          {/* Three small affordances: the cover is the canonical artifact,
              these are the alternate surfaces for AI ingestion / source
              inspection. */}
          <div class="mt-6 flex justify-center gap-x-6 gap-y-2 flex-wrap text-sm text-muted">
            <a href={data.pdf} target="_blank" rel="noopener" class="hover:text-accent">
              Read PDF{data.pdf_pages && ` · ${data.pdf_pages} pages`}
            </a>
            <a href={mdPath} class="hover:text-accent">Raw markdown</a>
            <a href={githubUrl} target="_blank" rel="noopener" class="hover:text-accent">View on GitHub</a>
          </div>
        </div>
        <hr class="border-rule mb-10" />
      </>
    )}

    {data.show_toc && h2s.length > 0 && (
      <nav class="mb-12 pb-8 border-b border-rule not-prose" aria-label="Sections">
        <p class="text-xs uppercase tracking-widest text-muted mb-4">Sections</p>
        <ol class="list-none p-0 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-sm">
          {h2s.map((h, i) => (
            <li>
              <a href={`#${h.slug}`} class="text-ink hover:text-accent no-underline flex items-baseline gap-3">
                <span class="text-muted tabular-nums text-xs shrink-0">{String(i + 1).padStart(2, '0')}</span>
                <span>{h.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="prose prose-lg max-w-none">
      <slot />
    </div>

    {data.related_essay && (
      <p class="text-sm text-muted mt-12">
        Related:{' '}
        <a href={data.related_essay} class="underline hover:text-accent">
          {relatedTitle ?? data.related_essay}
        </a>
      </p>
    )}

    {data.supporting_files && data.supporting_files.length > 0 && (
      <section class="mt-12 pt-6 border-t border-accent/40">
        <h2 class="font-serif text-xl text-ink mb-4">Supporting materials</h2>
        <ul class="space-y-4">
          {data.supporting_files.map((sf: any) => (
            <li>
              <div class="flex items-baseline gap-2 flex-wrap">
                <a href={sf.file} class="text-ink underline hover:text-accent">
                  {sf.title}
                </a>
                <span class="text-xs uppercase tracking-wide text-muted">
                  {sf.type}
                </span>
              </div>
              {sf.description && (
                <p class="text-sm text-muted mt-1">{sf.description}</p>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    <hr class="border-rule my-10" />

    <div class="flex flex-wrap gap-2 mb-6">
      {
        data.tags?.map((tag: string) => (
          <a
            href={`/tags/${tag}`}
            class="text-xs uppercase tracking-wide text-muted hover:text-ink border border-rule rounded px-2 py-0.5 no-underline"
            data-pagefind-filter={`tag:${tag}`}
          >
            {tag}
          </a>
        ))
      }
    </div>

    <div class="text-sm text-muted space-y-2">
      <p>
        Licensed{' '}
        <a
          href={
            data.license?.startsWith('CC0')
              ? 'https://creativecommons.org/publicdomain/zero/1.0/'
              : 'https://creativecommons.org/licenses/by/4.0/'
          }
          class="underline hover:text-ink"
        >
          {data.license}
        </a>.
      </p>
      {
        data.original_source && (
          <p>
            Original source: {data.original_source}
            {data.original_date && (
              <>
                {' '}({new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(data.original_date)})
              </>
            )}
          </p>
        )
      }
      {
        data.pdf && (
          <p>
            <a href={data.pdf} class="underline hover:text-ink">Download PDF</a>
          </p>
        )
      }
      <p>
        Markdown source:{' '}
        <a href={`${canonicalUrl}.md`} class="underline hover:text-ink"
          >{`${canonicalUrl}.md`}</a
        >
      </p>
      <p>
        Source on GitHub:{' '}
        <a href={githubUrl} target="_blank" rel="noopener" class="underline hover:text-ink">
          {`/src/content/${entry.collection}/${entry.slug}.md`}
        </a>
      </p>
    </div>

    <CiteThis
      title={data.title}
      slug={entry.slug}
      date={data.date}
      canonicalUrl={canonicalUrl}
      author={data.author}
      coAuthors={data.co_authors}
    />
  </article>
</BaseLayout>

<style is:global>
  /* Display pull-quote: when the markdown body opens with a blockquote
     (used as a hero epigraph), promote it from the typography plugin's
     small italic gray default to a large centered serif statement. */
  article .prose > blockquote:first-child {
    font-family: 'Iowan Old Style', Palatino, Georgia, serif;
    font-size: 2.25rem;
    line-height: 1.2;
    margin-top: 3rem;
    margin-bottom: 3rem;
    padding-left: 0;
    border-left: 0;
    text-align: center;
    font-style: normal;
    color: #1a1a1a;
    quotes: none;
  }
  article .prose > blockquote:first-child > p {
    margin: 0;
  }
  article .prose > blockquote:first-child > p::before,
  article .prose > blockquote:first-child > p::after {
    content: none;
  }
  /* Anchor scroll-margin so in-page TOC jumps don't tuck headings under
     any future sticky header. */
  article .prose h2 {
    scroll-margin-top: 6rem;
  }
</style>
