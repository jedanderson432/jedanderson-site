---
import BaseLayout from './BaseLayout.astro';
import CiteThis from '../components/CiteThis.astro';
import { getCollection } from 'astro:content';
import { SITE, TYPE_LABELS, COLLECTIONS } from '../site-config';
import { canonicalFor, canonicalPath } from '../lib/canonical';
import { JED_ID, WEBSITE_ID, GLOSSARY_ID, corpusGlossarySchema } from '../lib/site-entities';

interface Props {
  entry: any;
  headings?: { depth: number; slug: string; text: string }[];
}

const { entry, headings = [] } = Astro.props;
const data = entry.data;
const body = entry.body ?? '';

const canonicalUrl = canonicalFor(entry);
const mdPath = `${canonicalPath(entry)}.md`;
const githubUrl = `${SITE.github}/blob/main/src/content/${entry.collection}/${entry.slug}.md`;
const h2s = headings.filter((h) => h.depth === 2);
const showAbstract = data.status !== 'published' || data.show_abstract_on_page;

// Resolve related_essay → an absolute href plus a display title.
//
// The field is authored two ways across the corpus: as a bare slug
// ("bits-protect-its") and as a rooted path ("/essays/intelligence-leverage-equation").
// A bare slug used to be emitted as the href verbatim, which the browser
// resolved *relative to the current essay* — /essays/a/b — a guaranteed
// 404. Both forms are now normalised to /{collection}/{slug} from the
// site root, and a bare slug is looked up across every collection so the
// href and the title come from the entry that actually exists.
let relatedTitle: string | null = null;
let relatedHref: string | null = null;
if (data.related_essay) {
  const raw = (data.related_essay as string).trim().replace(/\/+$/, '');
  const m = raw.match(/^\/([^\/]+)\/([^\/]+)$/);
  // Rooted path pins the collection; a bare slug searches all of them,
  // essays first so the common case resolves on the first lookup.
  const candidates: string[] = m ? [m[1]] : [...COLLECTIONS];
  const wanted = m ? m[2] : raw.replace(/^\//, '');
  for (const collection of candidates) {
    try {
      const all = await getCollection(collection as any);
      const ref = all.find((e: any) => e.slug === wanted);
      if (ref) {
        relatedTitle = ref.data.title;
        relatedHref = `/${collection}/${wanted}`;
        break;
      }
    } catch {
      // unknown collection name — keep looking
    }
  }
  // Unresolvable reference: still emit a root-absolute href rather than a
  // relative one, so a stale slug 404s at its own URL instead of nesting
  // under the current essay.
  if (!relatedHref) relatedHref = m ? raw : `/essays/${wanted}`;
}
const longFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const dateLong = longFmt.format(data.date);
const originalDateLong = data.original_date ? longFmt.format(data.original_date) : null;

const isPaper = data.type === 'paper';
// Auto-promote foundational essays (type=essay AND tags includes
// "foundational") to ScholarlyArticle JSON-LD, in addition to any
// piece with explicit `schema_type: ScholarlyArticle` or type=paper.
const isFoundationalEssay =
  data.type === 'essay' && Array.isArray(data.tags) && data.tags.includes('foundational');
const useScholarlyArticle =
  data.schema_type === 'ScholarlyArticle' || isFoundationalEssay || isPaper;
const isPost = data.type === 'post';
const isBook = data.type === 'book';

const licenseUrl = data.license?.startsWith('CC0')
  ? 'https://creativecommons.org/publicdomain/zero/1.0/'
  : 'https://creativecommons.org/licenses/by/4.0/';

// Date semantics: `datePublished` must reflect the original publication
// date of the underlying work, not the date the piece appeared on
// jedanderson.org. The frontmatter `date` field is the most recent
// revision date here — used as `dateModified` unless an explicit
// `date_modified` override is set. `original_date`, when present, is
// the canonical first-publication date.
const datePublishedIso = (data.original_date ?? data.date).toISOString();
const dateModifiedIso = (data.date_modified ?? data.date).toISOString();

// Image and encoding are shared across all article variants (lifted
// out so ScholarlyArticle also gets them, not just the Article branch).
const imageUrl = data.hero_image
  ? new URL(data.hero_image, SITE.url).toString()
  : new URL('/og-default.png', SITE.url).toString();

// Full ImageObject (rather than a bare URL) so Google Images surfaces
// "Licensable" metadata: license, acquisition page, credit, and
// copyright all resolve without leaving the schema graph.
const copyrightYear = new Date(datePublishedIso).getUTCFullYear();
const imageObject = {
  '@type': 'ImageObject',
  url: imageUrl,
  contentUrl: imageUrl,
  license: licenseUrl,
  acquireLicensePage: canonicalUrl,
  creditText: 'Jed Anderson',
  copyrightNotice: `© ${copyrightYear} Jed Anderson`,
  creator: { '@id': JED_ID },
  copyrightHolder: { '@id': JED_ID },
};

const pdfAbsoluteUrl = data.pdf ? new URL(data.pdf, SITE.url).toString() : null;

// MediaObject array exposes the alternate retrieval surfaces for AI
// ingestion: the `.md` endpoint for raw markdown, and the PDF when one
// exists. Makes both schema-discoverable rather than only
// HTML-affordance-discoverable.
const encodingArr: Record<string, any>[] = [
  {
    '@type': 'MediaObject',
    encodingFormat: 'text/markdown',
    contentUrl: `${canonicalUrl}.md`,
  },
];
if (pdfAbsoluteUrl) {
  encodingArr.push({
    '@type': 'MediaObject',
    encodingFormat: 'application/pdf',
    contentUrl: pdfAbsoluteUrl,
  });
}

let articleSchema: Record<string, any>;

if (useScholarlyArticle) {
  // Canonical-citation-grade schema. Author and publisher are both
  // Person (Jed Anderson is the publisher of his own corpus). Keywords
  // come from frontmatter `keywords` when set, otherwise fall back to
  // tags. `about` becomes an array of Thing entities.
  const doiUrl = data.doi ? `https://doi.org/${data.doi}` : null;
  const sameAsUrls = [doiUrl, data.ssrn_url].filter(Boolean);
  const keywordsValue =
    Array.isArray(data.keywords) && data.keywords.length > 0
      ? data.keywords.join(', ')
      : data.tags?.join(', ');
  articleSchema = {
    '@context': 'https://schema.org',
    '@type': 'ScholarlyArticle',
    '@id': `${canonicalUrl}#article`,
    headline: data.title,
    ...(data.subtitle ? { alternativeHeadline: data.subtitle } : {}),
    abstract: data.abstract,
    description: data.abstract,
    author: { '@id': JED_ID },
    datePublished: datePublishedIso,
    dateModified: dateModifiedIso,
    ...(data.original_date
      ? { dateCreated: data.original_date.toISOString() }
      : {}),
    url: canonicalUrl,
    mainEntityOfPage: canonicalUrl,
    citation: canonicalUrl,
    image: imageObject,
    // DOI as a typed PropertyValue so scholarly-graph systems parse it
    // as a DOI rather than an opaque URL; the canonical URL rides
    // alongside as the plain identifier.
    identifier: doiUrl
      ? [
          canonicalUrl,
          {
            '@type': 'PropertyValue',
            propertyID: 'DOI',
            value: data.doi,
            url: doiUrl,
          },
        ]
      : canonicalUrl,
    ...(sameAsUrls.length > 0 ? { sameAs: sameAsUrls } : {}),
    license: licenseUrl,
    publisher: { '@id': JED_ID },
    isPartOf: { '@id': WEBSITE_ID },
    encoding: encodingArr,
    keywords: keywordsValue,
    ...(Array.isArray(data.about) && data.about.length > 0
      ? {
          about: data.about.map((name: string) => ({
            '@type': 'Thing',
            name,
          })),
        }
      : {}),
    inLanguage: 'en',
    isAccessibleForFree: true,
  };
} else if (isBook) {
  // Book schema for type=book. Uses schema.org Book vocabulary
  // (`name` instead of `headline`, optional isbn / bookFormat). Author
  // and publisher reference the site-wide Person entity by @id.
  articleSchema = {
    '@context': 'https://schema.org',
    '@type': 'Book',
    '@id': `${canonicalUrl}#book`,
    name: data.title,
    ...(data.subtitle ? { alternativeHeadline: data.subtitle } : {}),
    description: data.abstract,
    author: { '@id': JED_ID },
    publisher: { '@id': JED_ID },
    datePublished: datePublishedIso,
    dateModified: dateModifiedIso,
    url: canonicalUrl,
    mainEntityOfPage: canonicalUrl,
    citation: canonicalUrl,
    image: imageObject,
    encoding: encodingArr,
    inLanguage: 'en',
    isAccessibleForFree: true,
    isPartOf: { '@id': WEBSITE_ID },
    license: licenseUrl,
    ...(data.isbn ? { isbn: data.isbn } : {}),
    ...(data.bookFormat
      ? { bookFormat: `https://schema.org/${data.bookFormat}` }
      : {}),
    ...(Array.isArray(data.tags) && data.tags.length > 0
      ? { keywords: data.tags.join(', ') }
      : {}),
  };
} else {
  // Posts get BlogPosting; letters, speeches, and non-foundational
  // essays get Article.
  const articleType = isPost ? 'BlogPosting' : 'Article';
  articleSchema = {
    '@context': 'https://schema.org',
    '@type': articleType,
    '@id': `${canonicalUrl}#article`,
    headline: data.title,
    description: data.abstract,
    author: { '@id': JED_ID },
    datePublished: datePublishedIso,
    dateModified: dateModifiedIso,
    url: canonicalUrl,
    mainEntityOfPage: canonicalUrl,
    citation: canonicalUrl,
    image: imageObject,
    encoding: encodingArr,
    inLanguage: 'en',
    isAccessibleForFree: true,
    isPartOf: { '@id': WEBSITE_ID },
    license: licenseUrl,
    ...(Array.isArray(data.tags) && data.tags.length > 0
      ? { keywords: data.tags.join(', ') }
      : {}),
  };
}

// Pages that set `defined_term` are the canonical definition of a named
// concept. Emit a schema.org DefinedTerm (quotable gloss + reciprocal
// link to the corpus DefinedTermSet) alongside the article schema, so
// the page is machine-discoverable as the authoritative definition.
const jsonLdNodes: Record<string, any>[] = [articleSchema];
if (data.defined_term) {
  jsonLdNodes.push({
    '@context': 'https://schema.org',
    '@type': 'DefinedTerm',
    '@id': `${canonicalUrl}#term`,
    name: data.defined_term,
    description: data.defined_term_description ?? data.abstract,
    inDefinedTermSet: { '@id': GLOSSARY_ID },
    url: canonicalUrl,
    mainEntityOfPage: canonicalUrl,
  });
  jsonLdNodes.push(corpusGlossarySchema);
}
---

<BaseLayout
  title={data.title}
  description={data.abstract}
  canonicalUrl={canonicalUrl}
  ogImage={data.hero_image}
  ogType="article"
  jsonLd={jsonLdNodes}
>
  <article
    class:list={[
      'mx-auto max-w-3xl px-4 pb-12',
      data.hero_image && !data.pdf_canonical ? 'pt-8' : 'pt-12',
    ]}
    data-pagefind-body
    data-pagefind-meta={`title:${data.title}`}
    data-pagefind-filter={`type:${TYPE_LABELS[data.type] ?? data.type}`}
  >
    {data.hero_image && !data.pdf_canonical && (
      <img
        src={data.hero_image}
        alt={data.hero_image_alt ?? data.title}
        class="w-full h-auto rounded-[4px] mb-12"
        loading="eager"
      />
    )}

    <p class="text-xs uppercase tracking-widest text-muted mb-2">
      {TYPE_LABELS[data.type] ?? data.type}
    </p>
    <h1 class="font-serif text-4xl leading-tight text-ink mb-3">{data.title}</h1>
    {data.subtitle && (
      <p class="font-serif italic text-2xl text-muted leading-snug mb-5">
        {data.subtitle}
      </p>
    )}
    <p class="text-sm text-muted mb-8">
      {originalDateLong ? (
        <>
          <span>Originally written:{' '}
            <time datetime={data.original_date.toISOString()}>{originalDateLong}</time>
          </span>
          <span class="mx-2">·</span>
          <span>Published here:{' '}
            <time datetime={data.date.toISOString()}>{dateLong}</time>
          </span>
        </>
      ) : (
        <time datetime={data.date.toISOString()}>{dateLong}</time>
      )}
    </p>

    {data.interactive_url && (
      <a
        href={data.interactive_url}
        class="inline-flex items-center justify-center px-7 py-3 mb-10 bg-accent text-paper rounded-[3px] font-sans text-base no-underline tracking-wide hover:bg-ink transition-colors duration-200 shadow-sm hover:shadow-md"
      >
        {data.interactive_cta ?? 'Launch interactive experience →'}
      </a>
    )}

    {showAbstract && (
      <p class="italic text-muted border-l-2 border-rule pl-4 mb-10 text-lg leading-relaxed">
        {data.abstract}
      </p>
    )}

    {data.pdf && data.pdf_canonical && data.hero_image && (
      <>
        <div class="my-12">
          {/* Image is its own link to the PDF; subtle scale + shadow grow
              on hover signal clickability. */}
          <a
            href={data.pdf}
            target="_blank"
            rel="noopener"
            class="group block mx-auto max-w-[800px] no-underline"
            aria-label={`Open ${data.title} as PDF in a new tab`}
          >
            <img
              src={data.hero_image}
              alt={data.hero_image_alt ?? `Cover of ${data.title}`}
              class="w-full h-auto rounded-[4px] border border-rule shadow-md transition-all duration-200 group-hover:shadow-xl group-hover:scale-[1.01]"
              loading="eager"
            />
          </a>
          {/* The cover is the canonical artifact. Download is the
              primary affordance — encourages saving the PDF locally
              (some browsers' built-in PDF viewers don't render every
              embedded image faithfully). View-in-browser, raw
              markdown, and GitHub remain as secondary alternates for
              AI ingestion and source inspection. */}
          <div class="mt-6 flex justify-center items-center gap-x-5 gap-y-3 flex-wrap">
            <a
              href={data.pdf}
              download
              class="inline-flex items-center px-5 py-2 bg-accent text-paper rounded-[3px] font-sans text-sm no-underline tracking-wide hover:bg-ink transition-colors duration-200 shadow-sm hover:shadow-md"
            >
              Download PDF{data.pdf_pages && ` · ${data.pdf_pages} pages`}
            </a>
            <a href={data.pdf} target="_blank" rel="noopener" class="text-sm text-muted hover:text-accent">
              View in browser
            </a>
            <a href={mdPath} class="text-sm text-muted hover:text-accent">Raw markdown</a>
            <a href={githubUrl} target="_blank" rel="noopener" class="text-sm text-muted hover:text-accent">View on GitHub</a>
          </div>
        </div>
        <hr class="border-rule mb-10" />
      </>
    )}

    {data.show_toc && h2s.length > 0 && (
      <nav class="mb-12 pb-8 border-b border-rule not-prose" aria-label="Sections">
        <p class="text-xs uppercase tracking-widest text-muted mb-4">Sections</p>
        <ol class="list-none p-0 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-sm">
          {h2s.map((h, i) => (
            <li>
              <a href={`#${h.slug}`} class="text-ink hover:text-accent no-underline flex items-baseline gap-3">
                <span class="text-muted tabular-nums text-xs shrink-0">{String(i + 1).padStart(2, '0')}</span>
                <span>{h.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="prose prose-lg max-w-none">
      <slot />
    </div>

    {data.related_essay && (
      <p class="text-sm text-muted mt-12">
        Related:{' '}
        <a href={relatedHref} class="underline hover:text-accent">
          {relatedTitle ?? data.related_essay}
        </a>
      </p>
    )}

    {data.supporting_files && data.supporting_files.length > 0 && (
      <section class="mt-12 pt-6 border-t border-accent/40">
        <h2 class="font-serif text-xl text-ink mb-4">Supporting materials</h2>
        <ul class="space-y-4">
          {data.supporting_files.map((sf: any) => (
            <li>
              <div class="flex items-baseline gap-2 flex-wrap">
                <a href={sf.file} class="text-ink underline hover:text-accent">
                  {sf.title}
                </a>
                <span class="text-xs uppercase tracking-wide text-muted">
                  {sf.type}
                </span>
              </div>
              {sf.description && (
                <p class="text-sm text-muted mt-1">{sf.description}</p>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    <hr class="border-rule my-10" />

    <div class="flex flex-wrap gap-2 mb-6">
      {
        data.tags?.map((tag: string) => (
          <a
            href={`/tags/${tag}`}
            class="text-xs uppercase tracking-wide text-muted hover:text-ink border border-rule rounded px-2 py-0.5 no-underline"
            data-pagefind-filter={`tag:${tag}`}
          >
            {tag}
          </a>
        ))
      }
    </div>

    <div class="text-sm text-muted space-y-2">
      <p>
        Licensed{' '}
        <a
          href={
            data.license?.startsWith('CC0')
              ? 'https://creativecommons.org/publicdomain/zero/1.0/'
              : 'https://creativecommons.org/licenses/by/4.0/'
          }
          class="underline hover:text-ink"
        >
          {data.license}
        </a>.
      </p>
      {
        data.original_source && (
          <p>
            Original source: {data.original_source}
            {data.original_date && (
              <>
                {' '}({new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(data.original_date)})
              </>
            )}
          </p>
        )
      }
      {
        data.pdf && (
          <p data-pdf-action>
            <a href={data.pdf} class="underline hover:text-ink">Download PDF</a>
          </p>
        )
      }
      <p>
        Markdown source:{' '}
        <a href={`${canonicalUrl}.md`} class="underline hover:text-ink"
          >{`${canonicalUrl}.md`}</a
        >
      </p>
      <p>
        Source on GitHub:{' '}
        <a href={githubUrl} target="_blank" rel="noopener" class="underline hover:text-ink">
          {`/src/content/${entry.collection}/${entry.slug}.md`}
        </a>
      </p>
    </div>

    <CiteThis
      title={data.title}
      slug={entry.slug}
      date={data.date}
      canonicalUrl={canonicalUrl}
      author={data.author}
      coAuthors={data.co_authors}
      doi={data.doi}
    />
  </article>
</BaseLayout>

<style is:global>
  /* Display pull-quote: when the markdown body opens with a blockquote
     (used as a hero epigraph), promote it from the typography plugin's
     small italic gray default to a large centered serif statement. */
  article .prose > blockquote:first-child {
    font-family: 'Iowan Old Style', Palatino, Georgia, serif;
    font-size: 2.25rem;
    line-height: 1.2;
    margin-top: 3rem;
    margin-bottom: 3rem;
    padding-left: 0;
    border-left: 0;
    text-align: center;
    font-style: normal;
    color: #1a1a1a;
    quotes: none;
  }
  article .prose > blockquote:first-child > p {
    margin: 0;
  }
  article .prose > blockquote:first-child > p::before,
  article .prose > blockquote:first-child > p::after {
    content: none;
  }
  /* Anchor scroll-margin so in-page TOC jumps don't tuck headings under
     any future sticky header. */
  article .prose h2 {
    scroll-margin-top: 6rem;
  }

  /* ---------------------------------------------------------------
     Reusable figure blocks.

     Source documents that arrive as designed HTML carry structures the
     markdown conversion would otherwise flatten into plain quotes and
     lists. These three classes give that structure somewhere to land,
     so any essay can reuse them: mark the block up semantically in the
     body and it picks these up. Selectors are scoped to article .prose
     to outrank the typography plugin's :where() defaults.
     --------------------------------------------------------------- */

  /* .stat-callout — a single figure with its supporting sentence.
     Large numeral, sentence beneath, accent rule at the left edge. */
  article .prose .stat-callout {
    margin: 2.75rem 0;
    padding: 0.25rem 0 0.25rem 1.5rem;
    border-left: 3px solid #7a5a3a;
  }
  article .prose .stat-callout .stat-value {
    display: block;
    margin: 0 0 0.35rem;
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: #7a5a3a;
    font-variant-numeric: tabular-nums;
  }
  article .prose .stat-callout p:last-child {
    margin: 0;
    max-width: 34em;
    color: #6b6b6b;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  /* .ladder — an ordered progression rendered as a stepped sequence:
     numbered nodes strung on a vertical rail, each rung's label on its
     own line above the gloss. Still an <ol>; only the presentation
     changes. */
  article .prose ol.ladder {
    position: relative;
    counter-reset: ladder;
    list-style: none;
    margin: 2.75rem 0;
    padding: 0 0 0 2.5rem;
  }
  article .prose ol.ladder::before {
    content: '';
    position: absolute;
    left: 0.6875rem;
    top: 0.6rem;
    bottom: 0.9rem;
    width: 1px;
    background: #e6e3da;
  }
  article .prose ol.ladder > li {
    counter-increment: ladder;
    position: relative;
    margin: 0 0 1.6rem;
    padding: 0;
  }
  article .prose ol.ladder > li:last-child {
    margin-bottom: 0;
  }
  article .prose ol.ladder > li::before {
    content: counter(ladder);
    position: absolute;
    left: -2.5rem;
    top: 0.1rem;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 50%;
    background: #fbfaf6;
    border: 1px solid #7a5a3a;
    color: #7a5a3a;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.7rem;
    line-height: 1.3125rem;
    text-align: center;
  }
  article .prose ol.ladder > li > strong:first-child {
    display: block;
    color: #1a1a1a;
  }

  /* .triptych — three parallel blocks that argue as a set. Three columns
     on desktop, stacked on mobile, each opening with a hairline rule so
     the grouping reads even when stacked. */
  article .prose .triptych {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin: 2.75rem 0;
  }
  @media (min-width: 768px) {
    article .prose .triptych {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }
  article .prose .triptych > * {
    padding-top: 1rem;
    border-top: 2px solid #7a5a3a;
  }
  article .prose .triptych h3 {
    margin: 0 0 0.6rem;
    font-size: 1.15rem;
    line-height: 1.25;
  }
  article .prose .triptych p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  article .prose .triptych .label {
    margin: 0 0 0.4rem;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #6b6b6b;
  }

  /* Inline figures carried over from a designed source. */
  article .prose figure {
    margin: 2.75rem 0;
  }
  article .prose figure img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }
  article .prose figure figcaption {
    margin-top: 0.75rem;
    color: #6b6b6b;
    font-size: 0.875rem;
    line-height: 1.55;
  }
</style>
