---
import { SITE } from '../site-config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import { siteEntitySchemas } from '../lib/site-entities';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description = SITE.description,
  canonicalUrl,
  ogImage,
  ogType = 'website',
  jsonLd,
} = Astro.props;

// Search-engine ownership verification. Tokens live in the Netlify
// environment (see netlify.toml); the tags are emitted only when set,
// so local/CI builds without tokens are unaffected.
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;

const fullTitle = title ? `${title}—${SITE.title}` : SITE.title;
const resolvedCanonical = canonicalUrl ?? new URL(Astro.url.pathname, SITE.url).toString();
const resolvedOgImage = ogImage
  ? new URL(ogImage, SITE.url).toString()
  : new URL('/og-default.png', SITE.url).toString();

const pageScopedJsonLd = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];

// Site-wide Person/Organization/WebSite entities are emitted on every
// page so entity-resolution systems build a consistent graph. Page-
// specific schemas (Article, ScholarlyArticle, ProfilePage) follow.
// All nodes are emitted inside a single @graph with one shared @context
// so the cross-references (@id links between Person, Organization,
// WebSite, and the per-page Article) resolve within one document.
const graphNodes = [...siteEntitySchemas, ...pageScopedJsonLd].map((node) => {
  const { ['@context']: _ctx, ...rest } = node as Record<string, any>;
  return rest;
});
const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': graphNodes,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={resolvedCanonical} />
    {googleVerification && (
      <meta name="google-site-verification" content={googleVerification} />
    )}
    {bingVerification && (
      <meta name="msvalidate.01" content={bingVerification} />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title}—RSS`}
      href="/feed.xml"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:image" content={resolvedOgImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    {import.meta.env.PROD && (
      <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
    )}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />
  </head>
  <body class="bg-paper text-ink font-serif antialiased min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <SearchModal />
  </body>
</html>

<style is:global>
  /* Print stylesheet. Strips site chrome, switches to black-on-white,
     expands the article to full page width, and appends external-link
     URLs after their anchor text so a printed copy is self-contained.
     Internal anchors (#…, /…) and image-wrapping links are excluded
     from the URL appendix to avoid noise. */
  @media print {
    @page {
      margin: 0.75in;
    }

    body {
      background: #fff !important;
      color: #000 !important;
      font-size: 11pt;
      line-height: 1.45;
    }

    /* Site chrome — header nav, footer, search dialog, search trigger. */
    header,
    footer,
    dialog#search-modal,
    [data-search-trigger] {
      display: none !important;
    }

    /* The provenance block's "Download PDF" link is self-referential once
       the page IS the PDF. The licence and source URLs stay, so a printed
       copy still says where it came from. */
    [data-pdf-action] {
      display: none !important;
    }

    /* Interactive / navigational widgets on content pages.
       - <details> covers the CiteThis collapsible.
       - The Sections nav is the in-page TOC.
       - The tag chip row is identified by its data-pagefind-filter children. */
    article details,
    article nav[aria-label="Sections"],
    article > div:has(> a[data-pagefind-filter^="tag:"]) {
      display: none !important;
    }

    /* Let the article use the full @page text column. */
    main,
    article {
      max-width: none !important;
      padding: 0 !important;
      margin: 0 !important;
      background: transparent !important;
    }

    /* Page-break behavior. */
    h1, h2, h3, h4 {
      page-break-after: avoid;
      break-after: avoid;
    }
    blockquote, figure, pre, table, img {
      page-break-inside: avoid;
      break-inside: avoid;
    }
    p, li {
      orphans: 3;
      widows: 3;
    }

    article img {
      max-width: 100% !important;
      height: auto !important;
    }

    /* Strip animations/transforms/shadows that don't carry to paper. */
    * {
      transition: none !important;
      transform: none !important;
      box-shadow: none !important;
    }

    /* Show URLs after external links so the printout is self-contained. */
    a[href^="http"]::after,
    a[href^="https"]::after {
      content: " (" attr(href) ")";
      font-size: 0.85em;
      color: #555;
      word-break: break-all;
    }
    /* Suppress URL appendix for in-page anchors, relative paths,
       and links that wrap an image (the appendix would crowd the image). */
    a[href^="#"]::after,
    a[href^="/"]::after,
    a[data-internal-link]::after,
    a:has(> img)::after {
      content: "" !important;
    }

    /* Reusable figure blocks (.stat-callout / .ladder / .triptych) keep
       their structure on paper: rules go black, the triptych collapses
       to a single column so each block gets full measure, and no block
       is allowed to break across a page. */
    article .stat-callout,
    article ol.ladder > li,
    article .triptych > * {
      page-break-inside: avoid;
      break-inside: avoid;
    }
    article .stat-callout {
      border-left-color: #000 !important;
    }
    article .stat-callout .stat-value {
      color: #000 !important;
    }
    article ol.ladder > li::before {
      background: #fff !important;
      border-color: #000 !important;
      color: #000 !important;
    }
    /* Screen greys are too light for paper: darken the callout's
       supporting sentence, the ladder rail, and the triptych labels. */
    article .stat-callout p:last-child,
    article .triptych .label {
      color: #333 !important;
    }
    article ol.ladder::before {
      background: #999 !important;
    }
    article .triptych {
      grid-template-columns: 1fr !important;
      gap: 1.5rem !important;
    }
    article .triptych > * {
      border-top-color: #000 !important;
    }

    /* Body links: black + underlined, except image-wrapping links. */
    article a {
      color: #000 !important;
      text-decoration: underline;
    }
    article a:has(> img) {
      text-decoration: none !important;
    }
  }
</style>
