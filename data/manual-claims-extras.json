[
  // ============================================================================
  //  data/manual-claims-extras.json
  // ============================================================================
  //
  //  Hand-maintained companion to the deterministic claims extractor at
  //  scripts/extract-claims.mjs. Two purposes:
  //
  //    1. ADD claims the auto-extractor cannot catch (prose claims,
  //       composite claims, claims without a regex-compatible value/unit
  //       form). Give these IDs prefixed with "manual-".
  //
  //    2. OVERRIDE auto-extracted rows with epistemic_status, uncertainty
  //       notes, or richer derivation/citation context. Set the id to the
  //       exact "auto-..." id of the row you want to enrich; the merge in
  //       extract-claims.mjs does a shallow field-level overlay.
  //
  //  Schema (per row):
  //
  //    {
  //      "id":                "manual-<slug>" | "auto-<hash>"        REQUIRED
  //      "essay_slug":        "bond-bit-ratio"                       REQUIRED for new
  //      "value":             "240×"                                 REQUIRED for new
  //      "unit":              "ratio" | "J/bit" | "%" | ...          REQUIRED for new
  //      "type":              "manual" | "scientific" | ...          recommended
  //      "claim":             "<sentence>"                           REQUIRED for new
  //      "context":           "<surrounding ±200 chars>"             optional
  //      "line":              <int>                                  optional
  //      "epistemic_status":  "established" | "framework-dependent"
  //                            | "estimated" | "bet" | "needs_review"
  //      "uncertainty":       "<free-text note>"
  //      "last_verified":     "YYYY-MM-DD"
  //      "citation":          "<optional source citation string>"
  //    }
  //
  //  This file uses JSON-with-comments. The extractor strips // line
  //  comments before parsing, so you can annotate inline. Do NOT use
  //  /* block comments */ — the stripper only handles //.
  //
  //  License: CC-BY-4.0, like the rest of the corpus.
  //
  // ============================================================================
  //  EXAMPLE OVERRIDES — auto-extracted rows enriched with epistemic_status
  // ============================================================================

