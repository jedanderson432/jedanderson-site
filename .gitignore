node_modules
dist
.env
.env.*
.DS_Store
.netlify
.astro
.claude/*
!.claude/commands/

# Source PDFs at repo root — published versions live in /public/pdfs/
/The-First-Defender.pdf
/the-universe-is-information*.pdf

# Raw source PDFs staged for ingestion. The public-served copies in
# /public/pdfs/ (and any extracted images in /public/images/) are what
# gets versioned; the source-of-truth originals live here for re-runs
# but stay out of the repo.
/corpus-ingest/

# Transient extraction artifacts in scripts/ (raw text, draft markdown,
# extraction manifests). The .py / .mjs scripts themselves stay tracked.
scripts/_*.txt
scripts/_*.md
scripts/_*.json

# Python bytecode
scripts/__pycache__/

# Originals saved by scripts/clean-post-encoding.py before rewrite
_post-cleanup-backup/

# Per-run log + stats from extract-cc-emails.py
scripts/extract-cc-emails.log
scripts/cc-ingest-stats.json

# Hugging Face dataset export. The scaffolding (scripts/export-hf-dataset.mjs)
# and the dataset card (dataset/README.md) are tracked; the generated data
# artifacts are regenerable via `npm run export-hf` and stay out of the repo
# (corpus.jsonl is ~6MB; canonical-claims.json is already versioned under
# public/data/). Keep the folder structure but ignore the heavy outputs.
/dataset/corpus.jsonl
/dataset/canonical-claims.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE
.vscode/*
!.vscode/extensions.json
.idea

# Transient draft-PDF rendering artifacts (HTML intermediates + verification page images)
scripts/_draft-pdf-html/
scripts/_draft-pdf-shots/
